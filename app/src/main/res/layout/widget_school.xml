<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#171923">
    <TextView android:id="@+id/widget_day" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="QWISTER • СЬОГОДНІ" android:textColor="#8CCBFF" android:textStyle="bold" android:textSize="11sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_subject" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Завантаження…" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="19sp" android:maxLines="2" />
    <TextView android:id="@+id/widget_room" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Кабінет —" android:textColor="#D4D7E2" android:textSize="13sp" android:maxLines="1" />
    <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="7dp"
        android:max="100" android:progress="0" android:progressTint="#72C7FF" android:progressBackgroundTint="#343847" />
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="08:00–08:45" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1" />
    <TextView android:id="@+id/widget_countdown" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="До дзвінка: —" android:textColor="#8CCBFF" android:textSize="12sp" android:maxLines="1" />
</LinearLayout>
